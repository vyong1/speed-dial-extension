{
  "manifest_version": 3,
  "name": "Speed Dial",
  "version": "1.0.0",
  "description": "A customizable collection of website speed dials.",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "favicon_16.png",
    "32": "favicon_32.png",
    "48": "favicon_48.png",
    "128": "favicon_128.png"
  }
}
